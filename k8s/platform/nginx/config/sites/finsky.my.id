server {
    listen 80 default_server;
    server_name finsky.my.id *.finsky.my.id;

    include /etc/nginx/conf.d/global_error.conf;
    include /etc/nginx/snippets/static_cache.conf;

    root /usr/share/nginx/html/portofolio;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}